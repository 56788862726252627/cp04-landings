{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://internal.cp04-agency/schemas/make-qa/whatsapp-template-message.schema.json",
  "title": "CP04 Make QA — WhatsApp Template Message (mock)",
  "description": "Contrato de un mensaje de plantilla WhatsApp Business Cloud simulado. idempotency_key con prefijo QA_CP04_ es obligatorio — es la marca estructural que distingue un envío de prueba de uno real y habilita whatsapp-mock.mjs (dedup). 'to' exige formato E.164 completo (+ código de país, sin espacios/guiones).",
  "type": "object",
  "additionalProperties": false,
  "required": ["to", "template_name", "language", "category", "components", "idempotency_key"],
  "properties": {
    "to": { "type": "string", "pattern": "^\\+[1-9][0-9]{6,14}$" },
    "template_name": { "type": "string", "enum": ["reminder_2h_before", "no_show_followup", "membership_frozen", "waitlist_slot_available", "birthday_greeting", "referral_program", "payment_dunning", "security_alert_access"] },
    "language": { "type": "string", "pattern": "^[a-z]{2}(_[A-Z]{2})?$" },
    "category": { "type": "string", "enum": ["UTILITY", "MARKETING", "AUTHENTICATION"] },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "parameters"],
        "properties": {
          "type": { "type": "string", "enum": ["body", "header", "button"] },
          "parameters": { "type": "array", "items": { "type": "object", "required": ["type", "text"], "properties": { "type": { "type": "string", "enum": ["text"] }, "text": { "type": "string", "minLength": 1, "maxLength": 200 } } } }
        }
      }
    },
    "idempotency_key": { "type": "string", "pattern": "^QA_CP04_" }
  }
}
