{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://internal.cp04-agency/schemas/whatsapp/delivery-status-event.schema.json",
  "title": "CP04 WhatsApp Adapter — Delivery Status Event (normalized, mock)",
  "description": "Contrato del evento NORMALIZADO producido por worker-reservas/messaging/whatsapp-delivery-status.mjs#normalizeDeliveryStatusEvent() — no es la forma cruda del webhook de Meta (entry[].changes[].value.statuses[]), es la salida ya limpia de este adapter, con tenant_id/idempotency_key añadidos tras correlateDeliveryEvent(). error_code/error_message/retryable/category solo se rellenan cuando status:'FAILED'.",
  "type": "object",
  "additionalProperties": false,
  "required": ["message_id", "status", "timestamp", "recipient", "error_code", "error_message", "retryable", "category"],
  "properties": {
    "message_id": { "type": ["string", "null"], "pattern": "^wamid\\..+$" },
    "status": { "type": "string", "enum": ["SENT", "DELIVERED", "READ", "FAILED", "UNKNOWN"] },
    "timestamp": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3})?Z$" },
    "recipient": { "type": ["string", "null"], "pattern": "^\\+[1-9][0-9]{6,14}$" },
    "error_code": { "type": ["number", "null"] },
    "error_message": { "type": ["string", "null"] },
    "retryable": { "type": ["boolean", "null"] },
    "category": { "type": ["string", "null"] },
    "tenant_id": { "type": "string", "minLength": 1 },
    "idempotency_key": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "FAILED" } }, "required": ["status"] },
      "then": { "required": ["error_code"], "properties": { "error_code": { "type": "number" } } }
    }
  ]
}
