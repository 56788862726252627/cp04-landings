{
  "output": {
    "filePath": "fabrica-saas/.ai/context/generated/factory-full.xml",
    "style": "xml",
    "compress": true,
    "showLineNumbers": true,
    "removeComments": false,
    "removeEmptyLines": true,
    "headerText": "FABRICA SAAS — Full Context (V1.6) — Generated by Repomix"
  },
  "include": [
    "fabrica-saas/**/*.js",
    "fabrica-saas/**/*.mjs",
    "fabrica-saas/**/*.jsx",
    "fabrica-saas/**/*.ts",
    "fabrica-saas/**/*.yaml",
    "fabrica-saas/**/*.yml",
    "fabrica-saas/**/*.json",
    "fabrica-saas/**/*.md"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "node_modules/**",
      "dist/**",
      "build/**",
      "fabrica-saas/deploy/**",
      "fabrica-saas/.ai/context/generated/**",
      "fabrica-saas/output/**",
      "**/*.env",
      "**/.env*",
      "**/*.secret",
      "**/*.key",
      "**/*.pem",
      "**/*.p12",
      "**/credentials*",
      "**/secrets*",
      "**/*.bin",
      "**/*.exe",
      "**/*.zip",
      "**/*.tar*",
      "**/*.png",
      "**/*.jpg",
      "**/*.jpeg",
      "**/*.svg",
      "**/*.ico",
      "**/*.woff*",
      "**/*.ttf",
      "**/backup*",
      "**/*.backup",
      "**/*.tmp",
      "**/*.log"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  }
}
