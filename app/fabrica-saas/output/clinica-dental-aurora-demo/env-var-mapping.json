    "cfScope": "worker_secret",
    "manual": true
  },
  {
    "name": "AIRTABLE_BASE_ID",
    "scope": "worker_secret",
    "description": "Base ID de Airtable (solo Worker)",
    "command": "wrangler secret put AIRTABLE_BASE_ID",
    "cfScope": "worker_secret",
    "manual": true
  },
  {
    "name": "VITE_ANALYTICS_DSN",
    "scope": "vite_public",
    "description": "DSN del proveedor de analytics",
    "command": "wrangler pages env add production VITE_ANALYTICS_DSN <value>",
    "cfScope": "pages_env",
