# ─── PÚBLICAS (prefijo VITE_: expuestas al frontend) ───────────────
VITE_API_BASE_URL=NOT_CONFIGURED
VITE_AUTH_DOMAIN=NOT_CONFIGURED
VITE_AUTH_CLIENT_ID=NOT_CONFIGURED
VITE_ANALYTICS_DSN=NOT_CONFIGURED

# ─── SECRETOS DE WORKER (via wrangler secret put, NUNCA en .env) ─
