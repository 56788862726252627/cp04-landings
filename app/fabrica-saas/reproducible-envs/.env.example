# .env.example — ADV-15 environment template
# Copy to .env.runtime and fill in REAL values from your secret manager
# NEVER commit .env.runtime — it is excluded by .dockerignore
# NO_REAL_SECRETS=SI — this file contains only safe placeholders

# ── Runtime config (non-secret) ────────────────────────────────────────────────
NODE_ENV=development
PORT=5180
LOG_LEVEL=info
APP_NAME=factory-saas

# ── Secret references (obtain from secret manager / CI environment) ─────────────
# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Airtable
AIRTABLE_API_KEY=your_airtable_api_key_here
AIRTABLE_BASE_ID=your_airtable_base_id_here

# Make (webhooks)
MAKE_WEBHOOK_URL=https://hook.eu1.make.com/your_webhook_id_here

# Stripe (when enabled)
STRIPE_SECRET_KEY=sk_test_your_stripe_test_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# OpenAI / AI Router
OPENAI_API_KEY=your_openai_api_key_here
