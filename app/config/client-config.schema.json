{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agencia-ia.internal/schemas/client-config/1.0.0/client-config.schema.json",
  "title": "Agencia IA — Client Configuration",
  "description": "Esquema de la capa CLIENT CONFIG descrita en docs/agencia-ia/ARCHITECTURE_CORE_VS_VERTICAL.md. Cubre datos concretos de un cliente dentro de un vertical ya soportado. NUNCA debe contener secretos (tokens, webhooks reales) — solo referencias por nombre a secrets gestionados fuera de este archivo (Wrangler secrets). No inventa integraciones que no existan en el código actual (ver enums cerrados de 'integrations').",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "clientId",
    "tenantId",
    "slug",
    "brand",
    "locale",
    "timezone",
    "roles",
    "features",
    "integrations",
    "plan",
    "domains",
    "contact",
    "support",
    "deploymentProfile"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0",
      "description": "Versión de este esquema contra la que valida el documento. Ver 'compatibilidad futura' en config/CLIENT_CONFIG_SCHEMA_GUIDE.md para el plan de migración a 2.x."
    },
    "clientId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
      "description": "Identificador interno estable (UUID v4), no cambia nunca."
    },
    "tenantId": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?$",
      "minLength": 2,
      "maxLength": 32,
      "description": "Identificador corto usado en routing/logs, único, minúsculas/números/guiones."
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,48}[a-z0-9])?$",
      "minLength": 2,
      "maxLength": 50,
      "description": "Usado en URLs/subdominios (p.ej. club-padel-04)."
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120, "description": "Nombre comercial visible." },
        "legalName": { "type": ["string", "null"], "default": null },
        "logo": { "type": ["string", "null"], "format": "uri", "default": null },
        "favicon": { "type": ["string", "null"], "format": "uri", "default": null },
        "images": { "type": "array", "items": { "type": "string", "format": "uri" }, "default": [] }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "description": "Tokens de color/tipografía. Espejo directo de src/theme.js (mismos nombres de campo). Opcional: si se omite, se usan los defaults actuales de theme.js (fail-safe, nunca una UI rota por ausencia de theme).",
      "properties": {
        "bg": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "surface": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "surface2": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "surface3": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "accent": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "accent2": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "primary": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "text": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "textDim": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "line": { "type": "string", "minLength": 1 },
        "danger": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "warning": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "fontDisplay": { "type": "string", "minLength": 1 },
        "fontBody": { "type": "string", "minLength": 1 }
      }
    },
    "locale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "currency"],
      "properties": {
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2}(-[A-Z]{2})?$",
          "description": "Código de idioma consumido por t()/TRANSLATIONS en src/App.jsx. No se fuerza un enum cerrado de códigos regionales exactos: se confirmó la presencia de es-ES y de bloques en/fr/it/pt/de en TRANSLATIONS, pero no se verificó el sufijo de región exacto de cada uno en esta sesión — forzar un enum no verificado sería inventar datos."
        },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$", "description": "ISO 4217, p.ej. EUR." }
      }
    },
    "timezone": {
      "type": "string",
      "pattern": "^[A-Za-z]+(_[A-Za-z]+)*\\/[A-Za-z]+(_[A-Za-z]+)*(\\/[A-Za-z]+(_[A-Za-z]+)*)?$",
      "description": "IANA tz database, p.ej. Europe/Madrid."
    },
    "courts": {
      "type": "array",
      "description": "Recursos reservables del vertical deportivo actual (pistas). Espejo de la constante COURTS en src/App.jsx:114. NO es obligatorio: un cliente de un vertical no deportivo no debe rellenar este campo (ver 'resources' en compatibilidad futura, config/CLIENT_CONFIG_SCHEMA_GUIDE.md).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "type"],
        "properties": {
          "id": { "type": ["string", "integer"] },
          "name": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 },
          "price60": { "type": "number", "minimum": 0 },
          "price90": { "type": "number", "minimum": 0 },
          "price120": { "type": "number", "minimum": 0 }
        }
      },
      "default": []
    },
    "bookingHours": {
      "type": "array",
      "description": "Horas de inicio de franja reservable, formato HH:MM. Espejo de BOOKING_HOURS en src/App.jsx:121 (lista plana; un hueco de mediodía se representa por la ausencia de esas horas en la lista, no por un campo 'apertura/cierre' separado que el código actual no tiene).",
      "items": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
      "default": []
    },
    "roles": {
      "type": "array",
      "description": "Subconjunto de roles activos para este cliente. Mecanismo fail-closed: cp04NormalizeRole (src/utils/rbac.js) degrada cualquier valor fuera de este enum a PLAYER en runtime, nunca a un rol más privilegiado.",
      "items": { "type": "string", "enum": ["PLAYER", "STAFF", "ADMIN", "SUPPORT"] },
      "minItems": 1,
      "uniqueItems": true
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "description": "Feature flags de este cliente. Todo lo no incluido explícitamente se resuelve a OFF por la cascada cliente→vertical→core definida en AGENCY_TENANT_CONFIG_MODEL.md — nunca a ON por ausencia de dato (fail-closed).",
      "properties": {
        "reservas": { "type": "boolean", "default": true },
        "cancelaciones": { "type": "boolean", "default": true },
        "reprogramaciones": { "type": "boolean", "default": true },
        "listaEspera": { "type": "boolean", "default": false },
        "torneos": { "type": "boolean", "default": false },
        "ranking": { "type": "boolean", "default": false },
        "emparejamientos": { "type": "boolean", "default": false },
        "crm": { "type": "boolean", "default": false },
        "nps": { "type": "boolean", "default": false },
        "noShow": { "type": "boolean", "default": false },
        "referidos": { "type": "boolean", "default": false },
        "membresias": { "type": "boolean", "default": false },
        "pagos": {
          "type": "boolean",
          "const": false,
          "default": false,
          "description": "Forzado false: Stripe no está activo en la app por regla de proyecto vigente (src/data/makeInventory.js, nota del escenario 6323441 — solo existe infraestructura del lado Make). Habilitarlo requiere una nueva versión de este schema, no un cambio de config de cliente."
        },
        "qr": { "type": "boolean", "default": false },
        "promociones": { "type": "boolean", "default": false },
        "ia": {
          "type": "boolean",
          "const": false,
          "default": false,
          "description": "Forzado false: no existe ninguna integración de IA en el código actual. No configurado = OFF."
        },
        "soporte": { "type": "boolean", "default": true },
        "dashboards": { "type": "boolean", "default": true },
        "automatizaciones": { "type": "boolean", "default": true },
        "campanas": { "type": "boolean", "default": false },
        "notificaciones": { "type": "boolean", "default": true },
        "whatsapp": {
          "type": "boolean",
          "const": false,
          "default": false,
          "description": "Forzado false: sin integración WhatsApp en la app, solo inventario observacional en Make."
        }
      }
    },
    "integrations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["automation", "data", "payments", "messaging", "ai"],
      "description": "Cada bloque representa una interfaz de integración real o explícitamente no implementada. No se listan proveedores que no existan en el código (ver enums cerrados).",
      "properties": {
        "automation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "enabled"],
          "properties": {
            "provider": { "type": "string", "enum": ["make"], "description": "Único proveedor de automatización implementado hoy." },
            "enabled": { "type": "boolean", "default": true },
            "webhookRef": {
              "type": ["string", "null"],
              "default": null,
              "description": "Nombre del secret (p.ej. \"MAKE_RESERVAS_WEBHOOK\"), NUNCA el valor. El valor real vive en Wrangler secrets, fuera de este archivo."
            }
          }
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "enabled"],
          "properties": {
            "provider": {
              "type": "string",
              "enum": ["airtable"],
              "description": "Único proveedor de datos implementado hoy. 'supabase' es FUTURO (ver AGENCY_MULTI_CLIENT_ARCHITECTURE.md) y no se añade al enum hasta que exista código real que lo consuma."
            },
            "enabled": { "type": "boolean", "default": true },
            "baseIdRef": { "type": ["string", "null"], "default": null, "description": "Nombre de referencia al Base ID de Airtable de este cliente, no el valor sensible en sí si se gestiona como secret." },
            "tablesRef": {
              "type": "object",
              "additionalProperties": { "type": "string" },
              "default": {},
              "description": "Mapa lógico->nombre de tabla, p.ej. { \"reservas\": \"tblXXXX\" }."
            }
          }
        },
        "payments": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "enabled"],
          "properties": {
            "provider": { "type": "string", "enum": ["none", "stripe"] },
            "enabled": {
              "type": "boolean",
              "const": false,
              "default": false,
              "description": "Forzado false por regla de proyecto vigente. Ver features.pagos."
            }
          }
        },
        "messaging": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "enabled"],
          "properties": {
            "provider": { "type": "string", "enum": ["none", "whatsapp"] },
            "enabled": {
              "type": "boolean",
              "const": false,
              "default": false,
              "description": "Forzado false por regla de proyecto vigente. Ver features.whatsapp."
            }
          }
        },
        "ai": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "enabled"],
          "properties": {
            "provider": { "type": "string", "enum": ["none"], "description": "Ningún proveedor de IA integrado en el código actual." },
            "enabled": { "type": "boolean", "const": false, "default": false }
          }
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "enum": ["starter", "pro", "premium"],
          "description": "Alineado con docs/agencia-ia/plantilla-deportiva-clonable/configuracion-conceptual/modulos/CONFIG_CONCEPTUAL_MODULOS.md (Starter/Pro/Premium)."
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "bookingsPerMonth": { "type": ["integer", "null"], "minimum": 0, "default": null },
            "users": { "type": ["integer", "null"], "minimum": 0, "default": null },
            "storageMB": { "type": ["integer", "null"], "minimum": 0, "default": null }
          },
          "default": {}
        }
      }
    },
    "domains": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subdomain"],
      "properties": {
        "primary": { "type": ["string", "null"], "format": "hostname", "default": null },
        "subdomain": { "type": "string", "format": "hostname" }
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["email"],
      "properties": {
        "email": { "type": "string", "format": "email" },
        "phone": { "type": ["string", "null"], "default": null },
        "address": { "type": ["string", "null"], "default": null }
      }
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level"],
      "properties": {
        "level": { "type": "string", "enum": ["basico", "prioritario", "dedicado"] },
        "channel": { "type": ["string", "null"], "default": null }
      }
    },
    "deploymentProfile": {
      "type": "string",
      "enum": ["development", "staging", "production"],
      "description": "Perfil de despliegue de este documento de configuración concreto (no del cliente en abstracto: un mismo cliente puede tener un client_config de staging y otro de production)."
    }
  },
  "examples": [
    {
      "schemaVersion": "1.0.0",
      "clientId": "3f2a1b10-8c3e-4b7a-9d2f-1a2b3c4d5e6f",
      "tenantId": "cp04",
      "slug": "club-padel-04",
      "brand": { "name": "Club Pádel 04" },
      "locale": { "language": "es-ES", "currency": "EUR" },
      "timezone": "Europe/Madrid",
      "roles": ["PLAYER", "STAFF", "ADMIN", "SUPPORT"],
      "features": { "torneos": true, "ranking": true },
      "integrations": {
        "automation": { "provider": "make", "enabled": true, "webhookRef": "MAKE_RESERVAS_WEBHOOK" },
        "data": { "provider": "airtable", "enabled": true, "baseIdRef": "AIRTABLE_BASE_ID" },
        "payments": { "provider": "none", "enabled": false },
        "messaging": { "provider": "none", "enabled": false },
        "ai": { "provider": "none", "enabled": false }
      },
      "plan": { "name": "pro" },
      "domains": { "primary": null, "subdomain": "club-padel-04.pages.dev" },
      "contact": { "email": "info@clubpadel04.example" },
      "support": { "level": "basico" },
      "deploymentProfile": "production"
    }
  ]
}
