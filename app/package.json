{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "factory:generate": "node fabrica-saas/generator/scripts/generate.mjs --manifest fabrica-saas/clients/clinica-dental-demo/manifest.yaml",
    "factory:generate:physio": "node fabrica-saas/generator/scripts/generate.mjs --manifest fabrica-saas/clients/clinica-fisioterapia-demo/manifest.yaml",
    "factory:generate:estetica": "node fabrica-saas/generator/scripts/generate.mjs --manifest fabrica-saas/clients/clinica-estetica-demo/manifest.yaml",
    "factory:generate:abogados": "node fabrica-saas/generator/scripts/generate.mjs --manifest fabrica-saas/clients/despacho-abogados-demo/manifest.yaml",
    "factory:test": "node --test fabrica-saas/generator/tests/generator.test.mjs fabrica-saas/generator/tests/dental-cases.test.mjs fabrica-saas/generator/tests/physio-cases.test.mjs fabrica-saas/generator/tests/estetica-cases.test.mjs fabrica-saas/generator/tests/abogados-cases.test.mjs",
    "factory:test:dental": "node --test fabrica-saas/generator/tests/generator.test.mjs fabrica-saas/generator/tests/dental-cases.test.mjs",
    "factory:test:physio": "node --test fabrica-saas/generator/tests/physio-cases.test.mjs",
    "factory:test:estetica": "node --test fabrica-saas/generator/tests/estetica-cases.test.mjs",
    "factory:test:abogados": "node --test fabrica-saas/generator/tests/abogados-cases.test.mjs"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12"
  }
}
